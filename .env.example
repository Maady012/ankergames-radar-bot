# AnkerGames Discord Radar Bot
# Copy this file to .env and set your DISCORD_WEBHOOK_URL

# Main Discord Webhook URL (all new games drop here)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: Separate category channel webhooks
# WEBHOOK_ACTION_RPG=https://discord.com/api/webhooks/...
# WEBHOOK_HORROR=https://discord.com/api/webhooks/...
# WEBHOOK_COOP=https://discord.com/api/webhooks/...
# WEBHOOK_STRATEGY=https://discord.com/api/webhooks/...
# WEBHOOK_INDIE=https://discord.com/api/webhooks/...

# Polling Interval (in seconds - default is 180s / 3 minutes)
CHECK_INTERVAL_SECONDS=180
